<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7">

    <!-- 顯示拍照或載入的圖片 -->

    <!-- 拍照按鈕 -->

    <!-- ChipGroup 顯示分析結果 -->

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationZ="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/takePhotoButton"
        android:layout_width="122dp"
        android:layout_height="107dp"
        android:layout_margin="-70dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/photo_b"
        android:src="@drawable/photobtn"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.86"
        tools:visibility="visible" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/thipGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/takePhotoButton"
        app:singleLine="true" />

    <!-- tipsLayout，初期は非表示。ScrollViewでラップし説明が長くてもスクロール可 -->
    <LinearLayout
        android:id="@+id/tipsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#DDFFFFFF"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/backToListBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/return_b"
                android:contentDescription="戻る"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <!-- ごみ名（置中） -->
            <TextView
                android:id="@+id/garbageNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="ごみ名"
                android:textSize="22sp"
                android:textStyle="bold"

                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </RelativeLayout>

        <ScrollView
            android:id="@+id/tipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp">

            <TextView
                android:id="@+id/tipsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="説明文"
                android:textSize="20sp" />
        </ScrollView>


        <View
            android:layout_width="match_parent"
            android:layout_height="72dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/descLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="170dp"

        android:background="#DDFFFFFF"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        tools:visibility="gone">

        <!-- 左側：可捲動 Chip 區塊 -->
        <ScrollView
            android:id="@+id/chipScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="30dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Chip Group -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/descChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="1dp"
                    app:singleLine="false"
                    app:singleSelection="false"
                    app:chipSpacing="1dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 右側：角色圖片 -->
        <ImageView
            android:id="@+id/characterImage"
            android:layout_width="147dp"
            android:layout_height="224dp"
            android:contentDescription="キャラクター"
            android:src="@drawable/gomimi" />

    </LinearLayout>


    <!-- 底部導航欄 -->
    <RelativeLayout
        android:id="@+id/btnLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <!--        <Button-->
        <!--            android:id="@+id/tipsbtn"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_alignTop="@+id/reshootBtn"-->
        <!--            android:layout_marginEnd="30dp"-->
        <!--            android:layout_toStartOf="@+id/reshootBtn"-->
        <!--            android:backgroundTint="#FFFAE6"-->
        <!--            android:text="Tips"-->
        <!--            android:textColor="#7F6B59"-->
        <!--            android:textSize="20sp" />-->

        <Button
            android:id="@+id/reshootBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:backgroundTint="#FFFAE6"
            android:text="再撮影"
            android:textColor="#7F6B59"
            android:textSize="20sp"
            android:visibility="visible" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/preview"
        app:layout_constraintEnd_toEndOf="@+id/preview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/preview"
        tools:visibility="visible" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#D9EC85"
        app:itemBackground="@drawable/nav_item_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
